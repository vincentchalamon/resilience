<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Biseau (arete) : lumiere du haut (clair en haut, sombre en bas), epaisseur uniforme -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="120dp" android:height="120dp" />
            <gradient
                android:angle="270"
                android:startColor="#479CAD"
                android:endColor="#156475" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Face : degrade de la couleur du mode -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <size android:width="120dp" android:height="120dp" />
            <gradient
                android:angle="135"
                android:startColor="#2599B1"
                android:endColor="#166B7D" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
