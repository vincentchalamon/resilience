<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Biseau (arete) : lumiere du haut (clair en haut, sombre en bas), epaisseur uniforme -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E98E9F"
                android:endColor="#9E3548" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <!-- Face : degrade de la couleur du mode -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E05E76"
                android:endColor="#A5384B" />
            <corners android:radius="58dp" />
        </shape>
    </item>
</layer-list>
